# The processor that kernels shipped as C are compiled for. `native` matches
# the judge, which compiles for the machine it runs on (-mcpu=native on ARM64,
# -march=native on x86-64), so a build on the machine that judged a kernel
# ships exactly the code that was judged. A wheel is built once and runs on
# every machine of its platform, so the release workflow names the oldest one
# the package supports: `apple-m1` on macOS, which every later chip can run,
# and `x86-64-v3` on Linux, the instruction-set level the assembly kernels are
# written to. The value replaces `native` in the judge's flag.
option('kernel_cpu', type: 'string', value: 'native',
       description: 'What the C kernels are compiled for: native, or a value for -mcpu (ARM64) or -march (x86-64), such as apple-m1 or x86-64-v3')
